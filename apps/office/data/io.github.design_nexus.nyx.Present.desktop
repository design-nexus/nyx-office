[Desktop Entry]
Type=Application
Name=Office
GenericName=Presentation
Comment=Opens presentations in Office: PowerPoint and OpenDocument files
Exec=nyx-present %F
Icon=io.github.design_nexus.nyx.Office
Terminal=false
NoDisplay=true
Categories=Office;Presentation;GTK;
MimeType=application/x-nyx-present;application/x-nexus-present;application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.oasis.opendocument.presentation;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Office
