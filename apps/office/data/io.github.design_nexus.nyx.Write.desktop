[Desktop Entry]
Type=Application
Name=Office
GenericName=Word Processor
Comment=Opens documents in Office: Word, OpenDocument, Markdown and text files
Exec=nyx-write %F
Icon=io.github.design_nexus.nyx.Office
Terminal=false
NoDisplay=true
Categories=Office;WordProcessor;GTK;
MimeType=application/x-nyx-write;application/x-nexus-write;application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/markdown;text/plain;application/vnd.oasis.opendocument.text;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Office
