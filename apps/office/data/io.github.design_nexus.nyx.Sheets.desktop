[Desktop Entry]
Type=Application
Name=Office
GenericName=Spreadsheet
Comment=Opens spreadsheets in Office: Excel, OpenDocument and CSV files
Exec=nyx-sheets %F
Icon=io.github.design_nexus.nyx.Office
Terminal=false
NoDisplay=true
Categories=Office;Spreadsheet;GTK;
MimeType=application/x-nyx-sheets;application/x-nexus-sheets;text/csv;application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;application/vnd.oasis.opendocument.spreadsheet;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nyx.Office
